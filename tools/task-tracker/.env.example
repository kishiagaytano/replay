# Supabase connection (shared database).
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Dashboard → Project Settings → Data API (or API).
#
# These are PUBLIC values (the anon key is meant for browsers, protected by Row
# Level Security). Leaving them blank makes the app fall back to per-browser
# localStorage — nothing breaks, data just isn't shared.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
